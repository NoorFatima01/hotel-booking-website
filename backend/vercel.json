{
  "version": 2,
  "builds": [
    {
      "src": "src/index.ts",
      "use": "@vercel/node",
      "config": { 
        "includeFiles": [
          "src/**/*",          
          "package.json",      
          "tsconfig.json",     
          ".env*"              
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "src/index.ts" 
    }
  ]
}